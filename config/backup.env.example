# Project identification
PROJECT_NAME=

# MongoDB connection
MONGODB_URI=

# Local backup settings
BACKUP_ROOT=/opt/mongodb-backups
RETENTION_DAYS=3

# Backup schedule
BACKUP_INTERVAL_HOURS=6

# AWS S3 settings
S3_BUCKET=
S3_PREFIX=mongodb-backups
S3_RETENTION_DAYS=30

# Notification settings
EMAIL_NOTIFICATIONS_ENABLED=false