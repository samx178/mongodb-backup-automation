# Project identification
PROJECT_NAME=

# MongoDB connection
MONGODB_URI=

# Backup mode: database or cluster
BACKUP_MODE=database
DATABASE_NAME=

# Local backup settings
BACKUP_ROOT=/opt/mongodb-backups
RETENTION_DAYS=3

# Backup schedule
BACKUP_INTERVAL_HOURS=6

# AWS S3 settings
S3_BUCKET=
S3_PREFIX=mongodb-backups
S3_RETENTION_DAYS=30
AWS_REGION=ap-south-1

# Notification settings
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_SENDER=
NOTIFICATION_RECIPIENT=

# Optional SMTP configuration for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=